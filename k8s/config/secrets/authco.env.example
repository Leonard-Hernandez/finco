# authco-secret. Copy to authco.env (git-ignored) and fill in the values.
# Google OAuth client. Its redirect URIs must include
# http://localhost/authco/login/oauth2/code/google
google_client_id=
google_client_secret=
# AES-256 key that encrypts authco's signing keys at rest: base64 of 32 random bytes.
# Generate it with: openssl rand -base64 32
# Changing it later makes the stored signing keys unreadable.
master_key=
